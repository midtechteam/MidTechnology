# Supabase - Frontend (safe to expose to browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backend API URL (relative path for Vercel unified routing, or http://localhost:8000 for standalone local dev)
VITE_API_URL=/api

# App
VITE_APP_NAME=Scafbind
VITE_APP_ENV=development
